        ],
        "Rajshahi": [
          "Dhaka",
          "Rangpur"
        ],
        "Barishal": [
          "Dhaka",
          "Khulna"
        ],
        "Rangpur": [
          "Dhaka",
          "Rajshahi"
        ]
      },
      "matrix_symmetric": true,
      "node_order": [
        "Dhaka",
        "Chattogram",
        "Sylhet",
        "Khulna",
        "Rajshahi",
        "Barishal",
        "Rangpur"
      ],
      "reason": "Each undirected weighted edge contributes the same weight to cells (u, v) and (v, u), so the matrix equals its transpose. A directed graph or asymmetric directional weights would break this symmetry."
    },
    "exercise_2": {
      "best_layout": "Kamada-Kawai",
      "justification": "For this exact 15-node realization, Kamada-Kawai minimizes pairwise distance stress and makes the ring-like locality plus rewired shortcuts most legible; spring is a close alternative. The measured average clustering is 0.0, so no layout can reveal triangle-based clustering that is absent from the supplied k=3 realization.",
      "nodes": 15,
      "edges": 15,
      "average_clustering": 0.0
    },
    "exercise_3": {
      "is_bipartite": true,
      "students": 12,
      "courses": 6,
      "enrollments": 40,
      "most_popular_course": "Data Visualization",
      "most_popular_course_enrollments": 12,
      "most_enrolled_student": "Imran Kabir",
      "most_enrolled_student_courses": 5,
      "pattern": "Data Visualization bridges every represented major. Data Science students also concentrate in Machine Learning and Social Network Analysis, while Multimedia Technology students favor Human-Computer Interaction."
    },
    "exercise_4": {
      "nodes": 100,
      "edges": 196,
      "minimum_weight": 1,
      "maximum_weight": 10,
      "mean_weight": 5.387755102040816,
      "interpretation": "Edge width changes which ties appear salient, but seeded random weights are an encoding demonstration. Node centrality and edge weight are related only when the selected centrality definition explicitly uses weights."
    },
    "exercise_5": {
      "records": [
        {
          "Model": "Erdos-Renyi G(n,p)",
